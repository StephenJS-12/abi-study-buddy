{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abi-study-buddy",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",

  "assets": {
    // The whole site. Nothing outside public/ is ever reachable over the web.
    "directory": "./public",
    "binding": "ASSETS",

    // CRITICAL, and the one setting the whole password gate depends on.
    //
    // By default Cloudflare serves a matching static file BEFORE the Worker
    // runs, which would hand out every page, stylesheet and script to anyone
    // who knew the URL — the Worker would never see the request, so no amount
    // of code could stop it. This forces every request through src/index.js
    // first; assets are then served deliberately, via env.ASSETS.fetch().
    //
    // If this line is ever removed, the site silently becomes public.
    "run_worker_first": true
  },

  // Where her points, badges and answer history actually live, plus the
  // per-IP counters that throttle password guessing.
  //
  // This has to be declared here rather than added through the dashboard's
  // Bindings tab: `wrangler deploy` treats this file as the complete list and
  // drops anything it does not find, so a dashboard-added binding would
  // disappear on the next push. Secrets are the exception — those are stored
  // separately and survive deploys, which is why they are not in this file
  // (and must not be, since it is committed to git).
  //
  // The id is an account-scoped identifier, not a credential.
  "kv_namespaces": [
    { "binding": "PROGRESS", "id": "efd8c0153a9d44859ff4d381165f3853" }
  ]
}
